[Unit]
Description=H3K Config Center - AgileConfig Server
Documentation=https://github.com/dotnetcore/AgileConfig
After=network.target

[Service]
Type=notify
WorkingDirectory=/opt/h3k_config_center/v1.11.3
ExecStart=/home/ak/dotnet10/dotnet /opt/h3k_config_center/v1.11.3/AgileConfig.Server.Apisite.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
User=ak
Group=ak
# 环境变量可在此覆盖 appsettings.json
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
# 示例：数据库配置
# Environment=db:provider=mysql
# Environment=db:conn=Server=127.0.0.1;Database=configcenter;User=root;Password=xxx
# 示例：管理控制台、集群
# Environment=adminConsole=true
# Environment=cluster=true

[Install]
WantedBy=multi-user.target
